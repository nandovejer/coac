{
  "name": "quien-canta-hoy-en-el-coac",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "check:contrast": "luz-tokens check-contrast src/styles/theme-coac.css",
    "lint:luz": "luz-check dist/index.html src/styles src/components --theme src/styles/theme-coac.css --strict",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "deploy": "gh workflow run deploy.yml",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:compare": "node scripts/compare-visual.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@luz-ds/core": "0.3.0",
    "@luz-ds/tokens": "0.3.0",
    "jspdf": "4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9",
    "@luz-ds/check": "0.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react-swc": "4.3.3",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "globals": "^17.14.0",
    "prettier": "^3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8",
    "vite": "^7.3.7",
    "vitest": "^3"
  },
  "description": "Horario de las sesiones del COAC",
  "keywords": [
    "carnaval",
    "de",
    "cadiz",
    "cadiz",
    "coac"
  ],
  "author": "Nando Muñoz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandovejer/coac-quien-canta-hoy.git"
  },
  "bugs": {
    "url": "https://github.com/nandovejer/coac-quien-canta-hoy/issues"
  },
  "homepage": "https://github.com/nandovejer/coac-quien-canta-hoy#readme",
  "engines": {
    "node": ">=20"
  }
}
