{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sesiones de una fase del COAC",
  "description": "Fechas de sesión (dd/mm/yyyy) → agrupaciones en orden de actuación. Se valida también en el build (src/domain/validate.ts).",
  "type": "object",
  "minProperties": 1,
  "propertyNames": { "pattern": "^\\d{2}/\\d{2}/\\d{4}$" },
  "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "items": { "$ref": "#/definitions/agrupacion" }
  },
  "definitions": {
    "agrupacion": {
      "type": "object",
      "required": ["ranking", "modalidad", "nombre", "autor", "ciudad"],
      "properties": {
        "ranking": { "enum": ["top", "ok", "standar"] },
        "modalidad": { "enum": ["CORO", "COMPARSA", "CHIRIGOTA", "CUARTETO"] },
        "nombre": { "type": "string", "minLength": 1 },
        "autor": { "type": "string", "minLength": 1 },
        "ciudad": { "type": "string", "minLength": 1 }
      },
      "patternProperties": {
        "^\\d{4}$": {
          "type": "string",
          "minLength": 1,
          "description": "Agrupación del año anterior (la clave es ese año, p.ej. \"2025\"), o \"Nueva agrupación\"."
        }
      },
      "additionalProperties": false
    }
  }
}
